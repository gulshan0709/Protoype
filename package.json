{
  "name": "vizenta-ai",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "node scripts/export-web.cjs",
    "build:pages": "node scripts/build-pages.cjs",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages --nojekyll -d dist-pages",
    "build:native": "expo export --platform ios --platform android --output-dir dist-native",
    "typecheck": "tsc --noEmit",
    "contracts:import": "node scripts/import-contracts.cjs",
    "test": "node --test tests/contracts.test.cjs tests/class-setup.test.cjs tests/learner-setup.test.cjs tests/camera-setup.test.cjs tests/surveillance-setup.test.cjs tests/gate-attendance.test.cjs tests/demo-data.test.cjs tests/app-lock.test.cjs tests/priority.test.cjs tests/demo-volume.test.cjs tests/detection-demo.test.cjs",
    "test:ui": "node scripts/verify-ui.cjs",
    "test:auth": "node scripts/verify-auth.cjs",
    "test:pages": "node scripts/verify-pages.cjs",
    "test:refresh": "node scripts/verify-refresh.cjs",
    "test:showcase": "node scripts/verify-auth-showcase.cjs",
    "test:motion": "node scripts/verify-motion.cjs",
    "test:coverage": "node scripts/verify-coverage.cjs",
    "preview": "node scripts/serve.cjs",
    "format": "prettier --write \"app/**/*.tsx\" \"src/**/*.ts\" \"src/**/*.tsx\" \"scripts/*.cjs\" \"tests/*.cjs\"",
    "test:columns": "node scripts/verify-columns.cjs",
    "test:tables": "node scripts/verify-table-alignment.cjs",
    "test:class-setup": "node scripts/verify-class-setup.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "gh-pages": "^6.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3"
  }
}
